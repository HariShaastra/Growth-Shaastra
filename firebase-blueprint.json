{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user identity, vision, custom settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "identityStatement": { "type": "string" },
        "vision": { "type": "string" },
        "mission": { "type": "string" },
        "streak": { "type": "integer" },
        "lastRitualDate": { "type": "string" },
        "focusTime": { "type": "integer" },
        "breakTime": { "type": "integer" }
      }
    },
    "GrowthIdentity": {
      "title": "Identity Card",
      "description": "Represents a persona the user is building.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "Habit": {
      "title": "Daily Habit",
      "description": "Systemic actions under an identity.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "identityId": { "type": "string" },
        "target": { "type": "string" },
        "cue": { "type": "string" },
        "reward": { "type": "string" },
        "difficulty": { "type": "string" }
      }
    },
    "HabitLog": {
      "title": "Habit Completion Log",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "habitId": { "type": "string" },
        "completed": { "type": "boolean" }
      }
    },
    "Initiative": {
      "title": "Karya Initiative",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "stage": { "type": "string" },
        "problemStatement": { "type": "string" },
        "solution": { "type": "string" }
      }
    },
    "Book": {
      "title": "Book Library Item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Thought": {
      "title": "Book Thought",
      "type": "object",
      "properties": {
        "bookId": { "type": "string" },
        "content": { "type": "string" },
        "tag": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Profile settings" },
    "/users/{userId}/identities/{id}": { "schema": "GrowthIdentity", "description": "Atomic Identities" },
    "/users/{userId}/habits/{id}": { "schema": "Habit", "description": "Atomic Habits" },
    "/users/{userId}/habitLogs/{id}": { "schema": "HabitLog", "description": "Daily habit tracking" },
    "/users/{userId}/initiatives/{id}": { "schema": "Initiative", "description": "Karya Initiatives" },
    "/users/{userId}/books/{id}": { "schema": "Book", "description": "Book Library" },
    "/users/{userId}/thoughts/{id}": { "schema": "Thought", "description": "Book Reflection Thoughts" }
  }
}
