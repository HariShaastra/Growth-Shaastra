// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: userId (Auth UID)
// Fields:
//   - uid: string (required) - Firebase Auth UID
//   - displayName: string (optional) - User's name
//   - email: string (optional) - User's email
//   - identityStatement: string (required) - Core identity
//   - vision: string (optional) - Long-term vision
//   - mission: string (optional) - Life mission
//   - streak: number (optional) - Current streak
//   - lastRitualDate: string (optional) - YYYY-MM-DD
//   - createdAt: timestamp (required) - Creation time
//
// Collection: users/{userId}/goals
// Document ID: goalId
// Fields:
//   - title: string (required) - Goal title
//   - description: string (optional) - Goal details
//   - targetDate: string (optional) - YYYY-MM-DD
//   - status: string (required) - active, completed, archived
//   - createdAt: timestamp (required) - Creation time
//
// Collection: users/{userId}/rituals
// Document ID: date (YYYY-MM-DD)
// Fields:
//   - date: string (required) - YYYY-MM-DD
//   - stepsCompleted: list (required) - List of step IDs
//   - reflection: string (optional) - Daily reflection
//   - actedAccordingToIdentity: bool (optional) - Accountability check
//   - timestamp: timestamp (required) - Log time
//
// Collection: users/{userId}/stories
// Document ID: main
// Fields:
//   - content: string (required) - The life story
//   - updatedAt: timestamp (required) - Last update time
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Refined isAdmin check to avoid recursive lookup overhead when possible
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "hari310804@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      );
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // ===============================================================
    // Match Rules
    // ===============================================================

    match /users/{userId} {
      // Identity & Profile
      allow get: if isOwnerOrAdmin(userId);
      allow list: if isAdmin(); // Users shouldn't list each other
      
      allow create: if isOwner(userId) && 
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.get('role', 'user') == 'user'; // Prevent self-promotion
      
      allow update: if isOwner(userId) && 
        request.resource.data.uid == request.auth.uid &&
        // Protect role from modification by owner
        request.resource.data.get('role', 'user') == resource.data.get('role', 'user');

      // Subcollections
      
      match /identities/{id} {
        allow get, list: if isOwnerOrAdmin(userId);
        allow create, update, delete: if isOwner(userId);
      }
      
      match /habits/{id} {
        allow get: if isOwnerOrAdmin(userId);
        allow list: if isOwnerOrAdmin(userId);
        allow create, update: if isOwner(userId) && 
          request.resource.data.identityId is string &&
          request.resource.data.title is string && request.resource.data.title.size() < 200;
        allow delete: if isOwner(userId);
      }

      match /habitLogs/{id} {
        allow get, list: if isOwnerOrAdmin(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /initiatives/{id} {
        allow get: if isOwnerOrAdmin(userId);
        allow list: if isOwnerOrAdmin(userId);
        allow create, update: if isOwner(userId) && 
          request.resource.data.name is string && request.resource.data.name.size() < 200 &&
          request.resource.data.type in ['profit', 'non-profit', 'community'];
        allow delete: if isOwner(userId);
      }

      match /books/{id} {
        allow get: if isOwnerOrAdmin(userId);
        allow list: if isOwnerOrAdmin(userId);
        allow create, update: if isOwner(userId) && 
          request.resource.data.title is string && request.resource.data.title.size() < 200 &&
          request.resource.data.author is string && request.resource.data.author.size() < 200;
        allow delete: if isOwner(userId);
      }

      match /thoughts/{id} {
        allow get, list: if isOwnerOrAdmin(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow get, list: if isOwnerOrAdmin(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /rituals/{date} {
        allow get, list: if isOwnerOrAdmin(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /stories/{storyId} {
        allow get, list: if isOwnerOrAdmin(userId);
        allow create, update, delete: if isOwner(userId);
      }
    }
  }
}
